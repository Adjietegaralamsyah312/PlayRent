# PlayRent server — copy to .env (development defaults, no real secrets)
PORT=4000
DB_PATH=./data/playrent.db
SESSION_TTL_HOURS=12
NODE_ENV=development
# Allowlist origin browser, dipisah koma (tanpa path).
# Contoh produksi (frontend GitHub Pages):
#   CORS_ORIGIN=https://adjietegaralamsyah312.github.io
CORS_ORIGIN=http://localhost:5173
# lax | strict | none — default: none saat NODE_ENV=production, lax selain itu.
# Nilai tak dikenal diabaikan, dipakai default.
COOKIE_SAME_SITE=lax
# Jumlah proxy yang dipercaya (hop count), BUKAN boolean.
# 0 = X-Forwarded-For diabaikan (default aman). 1 = satu proxy tepercaya
# (Cloudflare Tunnel). Cloudflare MENAMBAH XFF, jadi 'true'/trust-all bisa
# dipakai penyerang untuk lolos rate limit login.
TRUST_PROXY=0
# Alamat bind server. Kosong = semua interface (0.0.0.0, default).
# Set 127.0.0.1 kalau API hanya diakses lewat Cloudflare Tunnel di mesin yang
# sama — klien LAN tidak bisa menyamar sebagai proxy (X-Forwarded-For palsu).
HOST=
# Leave unset for an HTTPS deployment (Secure cookie, default follows NODE_ENV).
# Set false ONLY for a plain-HTTP LAN deploy: the session cookie then travels
# unencrypted over the local network — trusted private networks only.
COOKIE_SECURE=
# Catatan lintas-situs: frontend GitHub Pages + API di origin lain → cookie
# sesi WAJIB SameSite=None dan Secure (Secure ikut NODE_ENV=production).
# Kalau COOKIE_SECURE=false, SameSite otomatis turun ke lax (browser membuang
# cookie SameSite=None tanpa Secure).
