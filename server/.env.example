# PlayRent server — copy to .env (development defaults, no real secrets)
PORT=4000
DB_PATH=./data/playrent.db
SESSION_TTL_HOURS=12
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
TRUST_PROXY=false
# Leave unset for an HTTPS deployment (Secure cookie, default follows NODE_ENV).
# Set false ONLY for a plain-HTTP LAN deploy: the session cookie then travels
# unencrypted over the local network — trusted private networks only.
COOKIE_SECURE=
